# Copy this file to .env.local and fill credentials locally.
# Never commit .env.local or put a real API key in this example file.
LLM_ENABLED=0
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_ANALYSIS_MODEL=qwen3.8-flash
LLM_VISION_MODEL=qwen3-vl-plus
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1000
LLM_TEMPERATURE=0.1
LLM_ENABLE_THINKING=0
LLM_ANALYSIS_TIMEOUT_SECONDS=30
LLM_FUSION_MODE=analysis_only
LLM_FUSION_ALPHA=0.0
LLM_FUSION_CANDIDATES=8
LLM_CACHE_ENABLED=1
VISION_ENABLED=1
VISION_MIN_CONFIDENCE=0.78
VISION_MAX_IMAGE_MB=10
VISION_CACHE_ENABLED=1
VISION_VLM_FALLBACK=1
VISION_OUTPUT_DIR=
# P0-C shadow experience capture. Default off; shadow never affects AI moves.
HEX_MEMORY_CAPTURE=off
HEX_MEMORY_DB=
HEX_MEMORY_QUEUE_SIZE=32
HEX_MEMORY_FLUSH_TIMEOUT_SECONDS=3
HEX_MEMORY_FAIL_OPEN=1